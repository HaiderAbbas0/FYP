# Copy to .env and fill in. The runtime works with NO keys at all - every agent
# falls back to its deterministic path and the safety properties are unchanged.

# Providers are tried in this order. Within a provider, keys rotate on 429/401.
LLM_PROVIDER_CHAIN=groq,gemini

# --- Groq (OpenAI-compatible) ----------------------------------------------
# Comma-separated pool. Check available models: GET /openai/v1/models
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini ------------------------------------------------------------------
# Comma-separated pool. Check available models: GET /v1beta/models
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=35

# --- Optional extra providers -----------------------------------------------
# ANTHROPIC_API_KEYS=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEYS=
# OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1
LLM_CB_THRESHOLD=4
LLM_CB_COOLDOWN_S=30

# Runtime security. SHA256 hex digests, never raw API keys. Roles viewer/operator/admin.
# Example shape: {"soc-admin":{"sha256":"<64-character SHA256 hex digest>","role":"admin"}}
IDS_API_KEYS_JSON={}
IDS_SESSION_SECRET=
IDS_SESSION_TTL_S=900
IDS_AUTH_DEV_LOCALHOST=false
IDS_AUTH_TRUSTED_ORIGINS_JSON=["http://localhost:8443","http://localhost:5173"]

# Empty DATABASE_URL selects local SQLite. PostgreSQL is shared by API+workers.
DATABASE_URL=
# IDS_SQLITE_PATH=D:/University/FYP/poc/MultiAgent-IoMT-IDS-POC/backend/data/runs.sqlite3
IDS_EMBEDDED_WORKER=true
RUN_WORKER_CONCURRENCY=1
RUN_QUEUE_CAPACITY=100
RUN_DEADLINE_S=180
SPECIALIST_EXECUTION=process
SPECIALIST_CONCURRENCY=5
SPECIALIST_TIMEOUT_S=8
LLM_TOTAL_BUDGET_S=40
ENABLE_VERIFIED_REUSE=false

# Optional isolated lab adapter, inactive until explicitly configured.
IDS_LAB_GATEWAY_URL=
IDS_LAB_GATEWAY_TOKEN=
IDS_LAB_TARGETS_JSON=[]
IDS_LAB_SENSOR_ID=independent-lab-sensor
IDS_LAB_MAX_ACTION_S=60

# Capture-replay detector. Default is the legacy binary RandomForest.
# Set to multiclass only to score with Hamd's staged LightGBM bundle.
# IDS_DETECTOR=legacy
# IDS_DETECTOR=multiclass
